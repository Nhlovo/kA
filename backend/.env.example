# Database
DATABASE_URL=postgresql://user:password@localhost:5432/kutlwano

# JWT
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# MFA
MFA_WINDOW=2

# Resend Email API
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@kutlwano.com

# Server
PORT=3001
NODE_ENV=development
BACKEND_URL=http://localhost:3001

# Frontend URLs
INTERNAL_DASHBOARD_URL=http://localhost:3000
ATTORNEY_PORTAL_URL=http://localhost:3001
DOCTOR_PORTAL_URL=http://localhost:3002

# Session
SESSION_TIMEOUT_ADMIN=900000
SESSION_TIMEOUT_FINANCE=1800000
SESSION_TIMEOUT_STAFF=1800000
SESSION_TIMEOUT_EXTERNAL=1800000

# File Storage
FILE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
